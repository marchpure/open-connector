FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY src ./src
ENV WEB_DISCOVERY_CHROME_PATH=/usr/bin/chromium
USER node
CMD ["node", "src/control-plane/web-discovery-worker-cli.ts"]
