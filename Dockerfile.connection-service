ARG CONNECTION_SERVICE_PLATFORM=linux/amd64
FROM --platform=$CONNECTION_SERVICE_PLATFORM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run generate:catalog \
  && npm prune --omit=dev --ignore-scripts

FROM --platform=$CONNECTION_SERVICE_PLATFORM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends tini \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /app/data/connection-service \
  && chown -R node:node /app/data
ENV NODE_ENV=production
ENV CONNECTION_SERVICE_HOST=0.0.0.0
ENV CONNECTION_SERVICE_PORT=3400
ENV CONNECTION_SERVICE_DATA_DIR=/app/data/connection-service
EXPOSE 3400
VOLUME ["/app/data/connection-service"]
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3400/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "src/control-plane/index.ts"]
