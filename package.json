{
  "name": "@oomol-lab/open-connector",
  "version": "1.4.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-generated.ts",
    "dev": "node scripts/dev-local.ts",
    "dev:api": "node scripts/ensure-generated.ts && node src/server/index.ts",
    "build": "npm run typecheck",
    "build:web": "npm run build --workspace web",
    "dev:cloudflare": "npm run generate:catalog && npm run build:web && node scripts/copy-catalog-assets.ts && wrangler dev --config wrangler.local.jsonc",
    "deploy:cloudflare": "npm run generate:catalog && npm run build:web && node scripts/copy-catalog-assets.ts && wrangler deploy --config wrangler.local.jsonc --minify",
    "start": "node scripts/ensure-generated.ts && node src/server/index.ts",
    "start:connection-service": "node scripts/ensure-generated.ts && node src/control-plane/index.ts",
    "start:web-discovery-worker": "node src/control-plane/web-discovery-worker-cli.ts",
    "test": "vitest run",
    "typecheck": "npm run generate:registry && node scripts/typecheck.ts src scripts-all examples",
    "generate:registry": "node scripts/generate-provider-registry.ts",
    "generate:catalog": "node scripts/generate-catalog.ts",
    "export:feishu-permissions": "node scripts/export-feishu-permissions.ts",
    "generate:provider": "node scripts/generate-provider.ts",
    "runtime:migrate": "node scripts/runtime-data.ts migrate",
    "runtime:data": "node scripts/runtime-data.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "fix": "npm run lint:fix && npm run format:fix",
    "fix-check": "npm run fix && npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@cfworker/json-schema": "^4.1.1",
    "@griffithswaite/ts-plsql-parser": "^1.1.1",
    "@hono/node-server": "^2.0.10",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@scalar/hono-api-reference": "^0.11.7",
    "ali-oss": "^6.23.0",
    "antlr4": "^4.13.0",
    "busboy": "^1.6.0",
    "fast-xml-builder": "^1.3.0",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.4.1",
    "fflate": "^0.8.3",
    "hono": "^4.12.27",
    "hyparquet": "^1.29.2",
    "hyparquet-compressors": "^1.1.1",
    "imapflow": "^1.4.6",
    "jose": "^6.2.3",
    "mailparser": "^3.9.14",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "minisearch": "^7.2.0",
    "mqtt": "^5.15.2",
    "mssql": "^12.7.0",
    "mysql2": "^3.24.2",
    "node-sql-parser": "^5.4.0",
    "nodemailer": "^9.0.3",
    "oracledb": "^6.10.0",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.62.1",
    "rss-parser": "^3.13.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@hyrious/configs": "^0.1.6",
    "@types/ali-oss": "^6.23.3",
    "@types/busboy": "^1.5.4",
    "@types/mailparser": "^3.4.6",
    "@types/mdast": "^4.0.4",
    "@types/mssql": "^9.1.11",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260630.1": true
  }
}
